{
  "name": "cacao-colab-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter=@cacao-colab/web",
    "dev:api": "turbo run dev --filter=@cacao-colab/api",
    "dev:mobile": "turbo run dev --filter=@cacao-colab/mobile"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5"
  }
}
